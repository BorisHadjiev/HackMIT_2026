[Unit]
Description=StrokeSense Alert Gateway (Linq)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/strokesense-gateway
EnvironmentFile=%h/strokesense-gateway/.env
ExecStart=%h/strokesense-gateway/.venv/bin/uvicorn gateway.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
