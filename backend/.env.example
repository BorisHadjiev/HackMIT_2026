# Copy to .env and fill in. NEVER commit the real .env (it holds the Linq/Deepgram tokens).

# Linq Partner API integration token (server-side only).
LINQ_API_TOKEN=linq_replace_me

# A phone number provisioned in your Linq organization, E.164 (e.g. +15550001111).
LINQ_FROM_NUMBER=

# Public base URL used to register the Linq webhook (no trailing slash), e.g.
#   LINQ_PUBLIC_BASE_URL=https://work.tail043976.ts.net
LINQ_PUBLIC_BASE_URL=

# Deepgram API key (server-side only; the APK talks to /v1/deepgram/stream).
DEEPGRAM_API_KEY=

# Optional shared secret Linq signs webhooks with; leave blank to skip verification.
WEBHOOK_SECRET=

# Shared secret the Android app sends as X-Alert-Gateway-Token.
# Generate one with: openssl rand -hex 32
GATEWAY_TOKEN=replace_me

# Comma-separated E.164 allowlist of trusted contacts.
# Use * to let each app user set their own trusted contact (token still required).
# Empty rejects everyone.
ALLOWED_RECIPIENTS=

# Local bind address. Keep on loopback; Tailscale Funnel fronts it.
BIND=127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=16384
DB_PATH=strokesense.db
