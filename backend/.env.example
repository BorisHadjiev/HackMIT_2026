# Copy to .env and fill in. NEVER commit the real .env (it holds the Linq/Deepgram tokens).

# Linq Partner API integration token (server-side only).
LINQ_API_TOKEN=linq_replace_me

# A phone number provisioned in your Linq organization, E.164 (e.g. +15550001111).
LINQ_FROM_NUMBER=

# Public base URL used to register the Linq webhook (no trailing slash), e.g.
#   LINQ_PUBLIC_BASE_URL=https://work.tail043976.ts.net
LINQ_PUBLIC_BASE_URL=

# Deepgram API key (server-side only; the APK talks to /v1/deepgram/stream).
DEEPGRAM_API_KEY=

# Optional shared secret Linq signs webhooks with; leave blank to skip verification.
WEBHOOK_SECRET=

# Shared secret the Android app sends as X-Alert-Gateway-Token.
# Generate one with: openssl rand -hex 32
GATEWAY_TOKEN=replace_me

# Comma-separated E.164 allowlist of trusted contacts.
# Use * to let each app user set their own trusted contact (token still required).
# Empty rejects everyone.
ALLOWED_RECIPIENTS=

# Local bind address. Keep on loopback; Tailscale Funnel fronts it.
BIND=127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=16384
DB_PATH=strokesense.db

# TTS (local). Engine: kokoro (fallback piper).
TTS_ENGINE=kokoro
TTS_VOICE=af_heart
TTS_MODELS_DIR=models/tts

# Local LLM (Ollama) for the voice agent.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:latest

# Speaker gating for the Deepgram proxy.
SPEAKER_GATE_ENABLED=false
SPEAKER_THRESHOLD=0.75
SPEAKER_EMBEDDING_PATH=speaker_embedding.npy

# Server-side slur analysis.
SLUR_MODEL_PATH=models/slur/slur_classifier_ssl_pathological.json
# Per-user slur voice profile (personal-centroid mode).
SLUR_PROFILE_PATH=models/slur/slur_profile.json
# Balanced operating point: personal-mode decision threshold, and the OOD cutoff
# above which uncalibrated (corpus) mode abstains instead of asserting slur.
SLUR_PERSONAL_THRESHOLD=0.40
SLUR_OOD_MAX=1.2

# Face debug view (/v1/face/debug) for the local proof-check harness.
# Keep disabled in production; the app never calls this route.
FACE_DEBUG_ENABLED=false
FACE_DEBUG_TOKEN=

# Transcription provider for /v1/asr/transcribe: deepgram | whisper | auto.
# whisper = local GPU (GB10); auto = whisper with deepgram fallback.
ASR_PROVIDER=auto
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
