# Copy to .env and fill in. NEVER commit the real .env (it holds the Linq token).

# Linq Partner API integration token (server-side only).
LINQ_API_TOKEN=linq_replace_me

# A phone number provisioned in your Linq organization, E.164 (e.g. +15550001111).
LINQ_FROM_NUMBER=

# Shared secret the Android app sends as X-Alert-Gateway-Token.
# Generate one with: openssl rand -hex 32
GATEWAY_TOKEN=replace_me

# Comma-separated E.164 allowlist of trusted contacts.
# Use * to let each app user set their own trusted contact (token still required).
# Empty rejects everyone.
ALLOWED_RECIPIENTS=

# Local bind address. Keep on loopback; Tailscale Funnel fronts it.
BIND=127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=16384
